# ── Photo Enhancer backend configuration ─────────────────────────────
# Copy to `.env` (git-ignored) and fill in. Nothing here is committed.

# CORS — the origin your toolkit is served from.
ALLOWED_ORIGIN=https://gatewayhq.github.io

# Claude — used to generate optimized prompts for generative steps and to
# analyze photos (exposure/white-balance/clutter). Same key format as the
# rest of the toolkit (sk-ant-...).
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ── Generative provider selection ────────────────────────────────────
# One of: imagen | replicate | fal | none
# "none" runs local (non-generative) enhancement only — always MLS-safe.
GENERATIVE_PROVIDER=imagen

# Imagen AI (primary). Business plan required; email Imagen for a key.
# Base: https://api.imagen-ai.com/v1
IMAGEN_API_KEY=
IMAGEN_BASE_URL=https://api.imagen-ai.com/v1
# The AI Profile that encodes your office "house style" (see house_style.py).
IMAGEN_PROFILE_KEY=

# Replicate (fallback for sky replacement / object removal / staging).
REPLICATE_API_TOKEN=

# Fal.ai (alternative fallback).
FAL_API_KEY=

# ── Operational ──────────────────────────────────────────────────────
# Max photos accepted in one batch request.
MAX_BATCH=40
# Max upload size per photo (bytes). iPhone JPEGs are typically 2–5 MB.
MAX_UPLOAD_BYTES=20971520
# Where finished renders + sidecars are written.
OUTPUT_DIR=./output
# Long edge (px) for MLS delivery. 2048 is the common MLS ceiling; many
# portals accept up to 3000+. Keep originals archived separately.
MLS_LONG_EDGE=2048
JPEG_QUALITY=90
